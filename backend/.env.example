DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

POST_REPAIR_VERIFICATION_HOURS=24
# Optional: full connection string (e.g. Neon). Overrides the DB_* values above.
DATABASE_URL=

# MQTT topics: optional namespace, must match the firmware TOPIC_PREFIX.
MQTT_TOPIC_PREFIX=
MQTT_CLIENT_ID=simms-backend

# Detection rules (Plan v2 defaults). For simulation runs use
# VACANCY_MINUTES=1 and COOLDOWN_MINUTES=2 so scenarios finish quickly.
VACANCY_MINUTES=10
COOLDOWN_MINUTES=30
MIN_VOTE_CONFIDENCE=0.55

# Ticket response SLA in hours per priority (Plan v2 §9.2). A ticket not
# started within its SLA is escalated. For a live demo use small values,
# e.g. SLA_HOURS_HIGH=0.05 (3 minutes).
SLA_HOURS_HIGH=2
SLA_HOURS_MEDIUM=8
SLA_HOURS_LOW=24
SLA_CHECK_INTERVAL_SECONDS=60

# Web Push (phone notifications). Generate a pair once with
#   python -m scripts.generate_vapid_keys
# Empty keys turn push off; in-app notifications still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Readings replayed after a network loss are stored but only vote in
# fault confirmation when younger than this.
LIVE_READING_MAX_AGE_SECONDS=90
# A sensor node or camera offline this long raises a Device offline ticket.
DEVICE_OFFLINE_FAULT_MINUTES=5

# Background jobs
NODE_OFFLINE_SECONDS=90
HEALTH_INTERVAL_SECONDS=60
DB_POOL_MAX=10

# Hosted MQTT broker (e.g. HiveMQ Cloud): port 8883 + TLS + credentials.
# Leave empty / 0 for local Mosquitto.
MQTT_TLS=0
MQTT_USERNAME=
MQTT_PASSWORD=

# Browser origins allowed to call the API (comma separated), and an
# optional regex for preview deployments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Circuit monitoring (per-unit currents until learned on the Circuits card)
DEFAULT_FAN_CURRENT_A=0.30
DEFAULT_LIGHT_CURRENT_A=0.10
CIRCUIT_OVERLOAD_FACTOR=1.25
CIRCUIT_OVERLOAD_MARGIN_A=0.5
MAIN_CURRENT_MAX_A=32
VOLTAGE_MIN_V=200
VOLTAGE_MAX_V=250
POWER_FACTOR_MIN=0.5
POWER_FACTOR_MIN_CURRENT_A=1.0
