DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

POST_REPAIR_VERIFICATION_HOURS=24
# Optional: full connection string (e.g. Neon). Overrides the DB_* values above.
DATABASE_URL=

# MQTT topics: optional namespace, must match the firmware TOPIC_PREFIX.
MQTT_TOPIC_PREFIX=
MQTT_CLIENT_ID=simms-backend

# Detection rules (Plan v2 defaults). For simulation runs use
# VACANCY_MINUTES=1 and COOLDOWN_MINUTES=2 so scenarios finish quickly.
VACANCY_MINUTES=10
COOLDOWN_MINUTES=30
MIN_VOTE_CONFIDENCE=0.55

# Background jobs
NODE_OFFLINE_SECONDS=90
HEALTH_INTERVAL_SECONDS=60
DB_POOL_MAX=10

# Hosted MQTT broker (e.g. HiveMQ Cloud): port 8883 + TLS + credentials.
# Leave empty / 0 for local Mosquitto.
MQTT_TLS=0
MQTT_USERNAME=
MQTT_PASSWORD=

# Browser origins allowed to call the API (comma separated), and an
# optional regex for preview deployments.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
